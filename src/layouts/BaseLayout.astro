---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Jacob Navaratne - Student & Developer',
	description = 'The personal website and portfolio of Jacob Navaratne, a student and developer from Kent, UK',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={Astro.url} />
		<meta name="theme-color" content="#0a0a0a" />
		<slot name="head" />
	</head>

	<body>
		<Navbar />

		<slot />

		<Footer />
	</body>
</html>