---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');

const sortedProjects = projects.sort((a, b) => {
	const yearA = a.data.year ?? 0;
	const yearB = b.data.year ?? 0;

	return yearB - yearA;
});
---

<BaseLayout
	title="Portfolio — Jacob Navaratne"
	description="A collection of projects built by Jacob Navaratne, a student and developer from Kent, UK."
>
	<main>
		<section class="portfolio-hero">
			<div class="container">
				<p class="eyebrow">Portfolio</p>

				<h1>
					Things I've
					<span> built.</span>
				</h1>

				<p class="intro">
					A collection of projects I've worked on while learning,
					experimenting and building with technology.
				</p>
			</div>
		</section>

		<section class="projects-section">
			<div class="container">
				<div class="section-header">
					<div>
						<p class="eyebrow">Selected work</p>
						<h2>Projects</h2>
					</div>

					<p class="project-count">
						{projects.length}
						{projects.length === 1 ? ' project' : ' projects'}
					</p>
				</div>

				{projects.length > 0 ? (
					<div class="projects-grid">
						{sortedProjects.map((project) => (
							<article class="project-card">
								<a
									href={`/portfolio/${project.id}`}
									class="project-main-link"
									aria-label={`View ${project.data.title} project`}
								>
									<div class="project-image">
										{project.data.image ? (
											<img
												src={project.data.image}
												alt={`${project.data.title} project screenshot`}
												loading="lazy"
											/>
										) : (
											<div class="image-placeholder">
												<span>Project preview coming soon</span>
											</div>
										)}

										<div class="image-overlay">
											<span>View project</span>
											<span class="arrow">↗</span>
										</div>
									</div>

									<div class="project-content">
										<div class="project-meta">
											<span>{project.data.category}</span>
											<span>{project.data.year}</span>
										</div>

										<h3>{project.data.title}</h3>

										<p class="project-description">
											{project.data.description}
										</p>

										<div class="technologies">
											{project.data.technologies.map((technology) => (
												<span>{technology}</span>
											))}
										</div>
									</div>
								</a>

								<div class="project-footer">
									<div class="project-status">
										<span class="status-dot"></span>
										<span>{project.data.status}</span>
									</div>

									<div class="project-links">
										{project.data.github && (
											<a
												href={project.data.github}
												target="_blank"
												rel="noopener noreferrer"
												aria-label={`View ${project.data.title} on GitHub`}
											>
												GitHub
												<span>↗</span>
											</a>
										)}

										{project.data.live && (
											<a
												href={project.data.live}
												target="_blank"
												rel="noopener noreferrer"
												aria-label={`Visit ${project.data.title} live site`}
											>
												Live site
												<span>↗</span>
											</a>
										)}
									</div>
								</div>
							</article>
						))}
					</div>
				) : (
					<div class="empty-state">
						<p>No projects yet.</p>
					</div>
				)}
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.portfolio-hero {
		padding: 160px 0 120px;
	}

	.eyebrow {
		margin-bottom: 20px;
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.portfolio-hero h1 {
		max-width: 900px;
		margin: 0 0 32px;
		font-size: clamp(4rem, 10vw, 8rem);
		font-weight: 600;
		letter-spacing: -0.07em;
		line-height: 0.9;
	}

	.portfolio-hero h1 span {
		color: var(--text-secondary);
	}

	.intro {
		max-width: 600px;
		margin: 0;
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		line-height: 1.6;
	}

	.projects-section {
		padding: 100px 0 140px;
		border-top: 1px solid var(--border);
	}

	.section-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 40px;
		margin-bottom: 60px;
	}

	.section-header .eyebrow {
		margin-bottom: 16px;
	}

	.section-header h2 {
		margin: 0;
		font-size: clamp(2.5rem, 5vw, 4.5rem);
		font-weight: 600;
		letter-spacing: -0.05em;
	}

	.project-count {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 32px;
	}

	.project-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
		transition:
			transform 220ms ease,
			border-color 220ms ease,
			box-shadow 220ms ease;
	}

	.project-card:hover {
		transform: translateY(-6px);
		border-color: rgba(33, 140, 90, 0.5);
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
	}

	.project-main-link {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.project-image {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--surface-elevated);
	}

	.project-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition:
			transform 500ms ease,
			filter 500ms ease;
	}

	.project-card:hover .project-image img {
		transform: scale(1.04);
		filter: brightness(0.7);
	}

	.image-placeholder {
		display: flex;
		width: 100%;
		height: 100%;
		align-items: center;
		justify-content: center;
		color: var(--text-muted);
	}

	.image-overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		background: rgba(10, 10, 10, 0.35);
		color: white;
		font-size: 0.9rem;
		font-weight: 600;
		opacity: 0;
		transition: opacity 220ms ease;
	}

	.project-card:hover .image-overlay {
		opacity: 1;
	}

	.arrow {
		color: var(--accent-hover);
		font-size: 1.1rem;
	}

	.project-content {
		padding: 32px 32px 28px;
	}

	.project-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 18px;
		color: var(--text-muted);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.project-content h3 {
		margin: 0 0 12px;
		color: var(--text-primary);
		font-size: 1.8rem;
		font-weight: 600;
		letter-spacing: -0.035em;
	}

	.project-description {
		display: -webkit-box;
		overflow: hidden;
		margin: 0 0 24px;
		color: var(--text-secondary);
		font-size: 0.95rem;
		line-height: 1.7;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.technologies {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
	}

	.technologies span {
		padding: 5px 9px;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.02);
		color: var(--text-secondary);
		font-size: 0.7rem;
		line-height: 1.4;
	}

	.project-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		margin-top: auto;
		padding: 18px 32px;
		border-top: 1px solid var(--border);
		background: rgba(255, 255, 255, 0.015);
	}

	.project-status {
		display: flex;
		align-items: center;
		gap: 8px;
		color: var(--text-muted);
		font-size: 0.75rem;
		white-space: nowrap;
	}

	.status-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 4px rgba(33, 140, 90, 0.12);
	}

	.project-links {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 16px;
	}

	.project-links a {
		color: var(--text-primary);
		font-size: 0.8rem;
		font-weight: 600;
		transition: color 180ms ease;
	}

	.project-links a:hover {
		color: var(--accent-hover);
	}

	.project-links span {
		margin-left: 3px;
		color: var(--accent);
	}

	.empty-state {
		padding: 80px 32px;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
		text-align: center;
	}

	.empty-state p {
		margin: 0;
		color: var(--text-muted);
	}

	@media (max-width: 900px) {
		.projects-grid {
			grid-template-columns: 1fr;
			max-width: 700px;
		}
	}

	@media (max-width: 800px) {
		.portfolio-hero {
			padding: 120px 0 90px;
		}

		.projects-section {
			padding: 80px 0 100px;
		}

		.section-header {
			margin-bottom: 40px;
		}
	}

	@media (max-width: 600px) {
		.portfolio-hero h1 {
			font-size: clamp(3.5rem, 17vw, 5rem);
		}

		.section-header {
			align-items: flex-start;
			flex-direction: column;
			gap: 16px;
		}

		.project-content {
			padding: 24px 22px 22px;
		}

		.project-footer {
			align-items: flex-start;
			flex-direction: column;
			padding: 16px 22px;
		}

		.project-links {
			justify-content: flex-start;
		}
	}
</style>