---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');

const sortedProjects = projects.sort((a, b) => {
	const yearA = a.data.year ?? 0;
	const yearB = b.data.year ?? 0;

	return yearB - yearA;
});
---

<BaseLayout
	title="Portfolio — Jacob Navaratne"
	description="A collection of projects built by Jacob Navaratne, a student and developer from Kent, UK."
>
	<main>
		<section class="portfolio-hero">
			<div class="container">
				<p class="eyebrow">Portfolio</p>

				<h1>
					Things I've
					<span>built.</span>
				</h1>

				<p class="intro">
					A collection of projects I've worked on while learning,
					experimenting and building with technology.
				</p>
			</div>
		</section>

		<section class="projects-section">
			<div class="container">
				<div class="section-header">
					<div>
						<p class="eyebrow">Selected work</p>
						<h2>Projects</h2>
					</div>

					<p class="project-count">
						{projects.length} {projects.length === 1 ? 'project' : 'projects'}
					</p>
				</div>

				<div class="projects-grid">
					{sortedProjects.map((project) => (
						<article class="project-card">
							<div class="project-image">
								{project.data.image ? (
									<img
										src={project.data.image}
										alt={`${project.data.title} project screenshot`}
										loading="lazy"
									/>
								) : (
									<div class="image-placeholder">
										<span>Project preview coming soon</span>
									</div>
								)}
							</div>

							<div class="project-content">
								<div class="project-meta">
									<span>{project.data.category}</span>
									<span>{project.data.year}</span>
								</div>

								<h3>{project.data.title}</h3>

								<p>{project.data.description}</p>

								<div class="technologies">
									{project.data.technologies.map((technology) => (
										<span>{technology}</span>
									))}
								</div>

								<div class="project-links">
									{project.data.github && (
										<a
											href={project.data.github}
											target="_blank"
											rel="noopener noreferrer"
										>
											GitHub
											<span>↗</span>
										</a>
									)}

									{project.data.live && (
										<a
											href={project.data.live}
											target="_blank"
											rel="noopener noreferrer"
										>
											Live site
											<span>↗</span>
										</a>
									)}
								</div>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.portfolio-hero {
		padding: 160px 0 120px;
	}

	.eyebrow {
		margin-bottom: 20px;
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.portfolio-hero h1 {
		max-width: 900px;
		margin: 0 0 32px;
		font-size: clamp(4rem, 10vw, 8rem);
		font-weight: 600;
		letter-spacing: -0.07em;
		line-height: 0.9;
	}

	.portfolio-hero h1 span {
		color: var(--text-secondary);
	}

	.intro {
		max-width: 600px;
		margin: 0;
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		line-height: 1.6;
	}

	.projects-section {
		padding: 100px 0 140px;
		border-top: 1px solid var(--border);
	}

	.section-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 40px;
		margin-bottom: 60px;
	}

	.section-header h2 {
		margin: 0;
		font-size: clamp(2.5rem, 5vw, 4.5rem);
		font-weight: 600;
		letter-spacing: -0.05em;
	}

	.project-count {
		margin: 0;
		color: var(--text-muted);
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 32px;
	}

	.project-card {
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
		transition:
			transform 220ms ease,
			border-color 220ms ease;
	}

	.project-card:hover {
		transform: translateY(-4px);
		border-color: var(--accent);
	}

	.project-image {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--surface-elevated);
	}

	.project-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 400ms ease;
	}

	.project-card:hover .project-image img {
		transform: scale(1.03);
	}

	.image-placeholder {
		display: flex;
		width: 100%;
		height: 100%;
		align-items: center;
		justify-content: center;
		color: var(--text-muted);
	}

	.project-content {
		padding: 32px;
	}

	.project-meta {
		display: flex;
		justify-content: space-between;
		margin-bottom: 20px;
		color: var(--text-muted);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.project-content h3 {
		margin-bottom: 12px;
		font-size: 1.8rem;
		font-weight: 600;
	}

	.project-content p {
		margin-bottom: 24px;
	}

	.technologies {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 28px;
	}

	.technologies span {
		padding: 6px 10px;
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--text-secondary);
		font-size: 0.75rem;
	}

	.project-links {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
	}

	.project-links a {
		color: var(--text-primary);
		font-size: 0.9rem;
		font-weight: 600;
	}

	.project-links a:hover {
		color: var(--accent-hover);
	}

	.project-links span {
		margin-left: 4px;
		color: var(--accent);
	}

	@media (max-width: 800px) {
		.portfolio-hero {
			padding: 120px 0 90px;
		}

		.projects-section {
			padding: 80px 0 100px;
		}

		.projects-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 600px) {
		.portfolio-hero h1 {
			font-size: clamp(3.5rem, 17vw, 5rem);
		}

		.section-header {
			align-items: flex-start;
			flex-direction: column;
			gap: 16px;
			margin-bottom: 40px;
		}

		.project-content {
			padding: 24px;
		}
	}
</style>