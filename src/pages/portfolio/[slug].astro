---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const projects = await getCollection('projects');

	return projects.map((project) => ({
		params: {
			slug: project.id,
		},
		props: {
			project,
		},
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout
	title={`${project.data.title} — Jacob Navaratne`}
	description={project.data.description}
>
	<main>
		<section class="project-hero">
			<div class="container">
				<a href="/portfolio" class="back-link">
					<span>←</span>
					Back to portfolio
				</a>

				<div class="project-meta">
					<span>{project.data.category}</span>
					<span>{project.data.year}</span>
					<span>{project.data.status}</span>
				</div>

				<h1>{project.data.title}</h1>

				<p class="project-description">
					{project.data.description}
				</p>

				<div class="project-links">
					{project.data.github && (
						<a
							href={project.data.github}
							target="_blank"
							rel="noopener noreferrer"
							class="button button-primary"
						>
							View on GitHub
							<span>↗</span>
						</a>
					)}

					{project.data.live && (
						<a
							href={project.data.live}
							target="_blank"
							rel="noopener noreferrer"
							class="button button-secondary"
						>
							Visit live site
							<span>↗</span>
						</a>
					)}
				</div>
			</div>
		</section>

		<section class="project-content-section">
			<div class="container">
				<div class="project-layout">
					<article class="project-content">
						{project.data.image && (
							<div class="hero-image">
								<img
									src={project.data.image}
									alt={`${project.data.title} project screenshot`}
								/>
							</div>
						)}

						<div class="content">
							<Content />
						</div>
					</article>

					<aside class="project-sidebar">
						<div class="sidebar-section">
							<h3>Technologies</h3>

							<div class="technologies">
								{project.data.technologies.map((technology) => (
									<span>{technology}</span>
								))}
							</div>
						</div>

						<div class="sidebar-section">
							<h3>My role</h3>
							<p>{project.data.role}</p>
						</div>

						<div class="sidebar-section">
							<h3>Started</h3>
							<p>{project.data.startDate}</p>
						</div>

						<div class="sidebar-section">
							<h3>Status</h3>
							<p>{project.data.status}</p>
						</div>

						<div class="sidebar-section">
							<h3>Challenges</h3>
							<p>{project.data.challenges}</p>
						</div>

						<div class="sidebar-section">
							<h3>What I learnt</h3>
							<p>{project.data.learned}</p>
						</div>
					</aside>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.project-hero {
		padding: 160px 0 100px;
		border-bottom: 1px solid var(--border);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 60px;
		color: var(--text-secondary);
		font-size: 0.9rem;
		transition: color 180ms ease;
	}

	.back-link:hover {
		color: var(--text-primary);
	}

	.back-link span {
		color: var(--accent);
		font-size: 1.1rem;
	}

	.project-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-bottom: 24px;
		color: var(--text-muted);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.project-meta span:not(:last-child)::after {
		content: '·';
		margin-left: 12px;
		color: var(--accent);
	}

	h1 {
		max-width: 1000px;
		margin: 0 0 32px;
		font-size: clamp(4rem, 10vw, 8rem);
		font-weight: 600;
		letter-spacing: -0.07em;
		line-height: 0.9;
	}

	.project-description {
		max-width: 700px;
		margin-bottom: 40px;
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		line-height: 1.6;
	}

	.project-links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		min-height: 48px;
		padding: 0 22px;
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 600;
		transition:
			background-color 180ms ease,
			border-color 180ms ease,
			transform 180ms ease;
	}

	.button:hover {
		transform: translateY(-2px);
	}

	.button-primary {
		background: var(--accent);
		color: white;
	}

	.button-primary:hover {
		background: var(--accent-hover);
	}

	.button-secondary {
		border: 1px solid var(--border-strong);
		background: var(--surface);
		color: var(--text-primary);
	}

	.button-secondary:hover {
		border-color: var(--accent);
	}

	.project-content-section {
		padding: 100px 0 140px;
	}

	.project-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 320px;
		gap: 100px;
		align-items: start;
	}

	.hero-image {
		overflow: hidden;
		margin-bottom: 60px;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
	}

	.hero-image img {
		width: 100%;
		height: auto;
	}

	.content {
		max-width: 750px;
	}

	.content :global(h2) {
		margin-top: 60px;
		margin-bottom: 20px;
		font-size: 2rem;
	}

	.content :global(h3) {
		margin-top: 40px;
		margin-bottom: 16px;
		font-size: 1.4rem;
	}

	.content :global(p) {
		margin-bottom: 24px;
		font-size: 1.05rem;
		line-height: 1.8;
	}

	.content :global(ul),
	.content :global(ol) {
		margin-bottom: 24px;
		padding-left: 24px;
		color: var(--text-secondary);
	}

	.content :global(li) {
		margin-bottom: 8px;
	}

	.project-sidebar {
		position: sticky;
		top: 100px;
	}

	.sidebar-section {
		padding: 24px 0;
		border-top: 1px solid var(--border);
	}

	.sidebar-section:first-child {
		padding-top: 0;
		border-top: 0;
	}

	.sidebar-section h3 {
		margin-bottom: 12px;
		color: var(--text-primary);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.sidebar-section p {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.technologies {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.technologies span {
		padding: 6px 10px;
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--text-secondary);
		font-size: 0.75rem;
	}

	@media (max-width: 900px) {
		.project-layout {
			grid-template-columns: 1fr;
			gap: 60px;
		}

		.project-sidebar {
			position: static;
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 0 40px;
		}
	}

	@media (max-width: 600px) {
		.project-hero {
			padding: 120px 0 80px;
		}

		.back-link {
			margin-bottom: 40px;
		}

		.project-content-section {
			padding: 80px 0 100px;
		}

		.project-sidebar {
			display: block;
		}

		.project-links {
			flex-direction: column;
		}

		.button {
			width: 100%;
		}
	}
</style>