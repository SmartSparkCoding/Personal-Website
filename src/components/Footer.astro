---
const commitSha = import.meta.env.VERCEL_GIT_COMMIT_SHA;
const shortCommitSha = commitSha ? commitSha.slice(0, 7) : 'local';

const deploymentTime = new Date();
const formattedDeploymentTime = deploymentTime.toLocaleString('en-GB', {
	timeZone: 'Europe/London',
	dateStyle: 'medium',
	timeStyle: 'short',
});
---

<footer class="site-footer">
	<div class="container">
		<div class="footer-main">
			<div class="footer-brand">
				<a href="/" class="footer-logo">Jacob Navaratne</a>

				<p>
					A developer and student building things with technology,
					software and AI.
				</p>
			</div>

			<div class="footer-links">
				<div class="footer-column">
					<h3>Explore</h3>

					<a href="/">Home</a>
					<a href="/#about">About</a>
					<a href="/portfolio">Portfolio</a>
					<a href="/#contact">Contact</a>
				</div>

				<div class="footer-column">
					<h3>Connect</h3>

					<a href="https://github.com/smartsparkcoding" target="_blank" rel="noopener noreferrer">
						GitHub <span>↗</span>
					</a>
					<a href="mailto:jacob@navaratne.uk">
						Email <span>↗</span>
					</a>
					<a href="https://www.linkedin.com/in/jacob-navaratne-53a076405 " target="_blank" rel="noopener noreferrer">
						LinkedIn <span>↗</span>
					</a>
					<a href="https://hackclub.enterprise.slack.com/team/U0AEYDUCLKF" target="_blank" rel="noopener noreferrer">
						Slack <span>↗</span>
					</a>
				</div>
			</div>
		</div>

		<div class="footer-bottom">
			<p>© {new Date().getFullYear()} Jacob Navaratne. All rights reserved.</p>

			<div class="footer-meta">
				<span>Built with Astro</span>
				<span class="footer-separator">·</span>
				<a href={`https://github.com/SmartSparkCoding/Personal-Website/commit/${commitSha}`} target="_blank" rel="noopener noreferrer" title={`View commit ${commitSha || 'local'}`}>
					Commit {shortCommitSha}
				</a>
				<span class="footer-separator">·</span>
				<span>Deployed {formattedDeploymentTime}</span>
			</div>
		</div>
	</div>
</footer>
